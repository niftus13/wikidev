MYSQL_ROOT_PASSWORD=replace-with-a-unique-root-password
MYSQL_PASSWORD=replace-with-a-unique-application-password

# 웹(Nuxt) 컨테이너와 API가 통신하는 전용 네트워크 대역과 웹 컨테이너 고정 주소.
# API의 TRUST_PROXY는 WEB_PROXY_IP 하나로 설정된다. 같은 호스트에서 다른 Compose 프로젝트(예: git worktree)를
# 함께 띄울 때는 대역이 겹치지 않게 두 값을 함께 바꾼다(예: 10.231.0.8/29, 10.231.0.14).
# WEB_API_SUBNET=10.231.0.0/29
# WEB_PROXY_IP=10.231.0.6

# 웹 /api 프록시 시간 제한(밀리초, 기본 30000). 넘으면 504 {"error":"Upstream timeout"}.
# NUXT_API_PROXY_TIMEOUT_MS=30000
