# 운영 환경 변수 예시 (compose.prod.yaml, deploy/deploy.sh). 런북: deploy/README.md
# 인스턴스에서 .env.production으로 복사하고 권한을 600(배포 사용자 소유)으로 둔다. 실제 값은 저장소·이미지에 넣지 않는다.
#   cp .env.production.example .env.production && chmod 600 .env.production

# 서비스 도메인(https:// 없이). API APP_ORIGIN은 https://<APP_DOMAIN>, COOKIE_SECURE=true로 고정된다.
APP_DOMAIN=<도메인>

# 각각 다른 임의 값(예: openssl rand -hex 24). MySQL 비밀번호는 볼륨을 처음 만들 때만 적용된다.
# 이미 데이터가 있으면 이 값만 바꿔서는 안 된다(런북 "DB 비밀번호 변경": ALTER USER 후 이 파일 갱신).
MYSQL_ROOT_PASSWORD=replace-with-a-unique-root-password
MYSQL_PASSWORD=replace-with-a-unique-application-password

# 웹-API 전용 Docker 네트워크. VPC CIDR·피어링 대역과 겹치지 않아야 한다.
# WEB_GATEWAY_IP: 이 네트워크의 게이트웨이. 호스트 nginx가 127.0.0.1:3000으로 접속하면 웹은 이 주소에서 온 연결로 본다.
#   웹 NUXT_WEB_TRUST_PROXY는 이 주소 하나로 정해진다(호스트에서 3000으로 오는 모든 연결을 믿는다는 뜻이다).
# WEB_PROXY_IP: 웹 컨테이너 고정 주소. API TRUST_PROXY는 이 주소 하나다.
# WEB_API_SUBNET=10.231.0.0/29
# WEB_GATEWAY_IP=10.231.0.1
# WEB_PROXY_IP=10.231.0.6

# 웹을 공개할 호스트 loopback 포트(nginx proxy_pass와 맞춘다). 주소는 127.0.0.1로 고정이다.
# WEB_HOST_PORT=3000

# 이미지 이름 접두사(<접두사>-web:<커밋>, <접두사>-api:<커밋>). 태그 WIKIBLOG_TAG는 deploy.sh가 커밋으로 정한다.
# WIKIBLOG_IMAGE=wikiblog
